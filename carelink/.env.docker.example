# ====================================================================
# CareLink Docker Compose Environment Configuration
# ====================================================================

# PostgreSQL Database Service
POSTGRES_DB=carelink_db
POSTGRES_USER=carelink_user
POSTGRES_PASSWORD=carelink_secure_password_2026
POSTGRES_PORT=5432

# FastAPI Application Server
PORT=8000

# JWT Authentication
JWT_SECRET_KEY=carelink-production-docker-secret-key-32bytes-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Demo Seeder Flag (Set to true to provision fictional clinical accounts & wards)
SEED_DEMO_DATA=true
